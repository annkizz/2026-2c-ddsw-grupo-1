ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SERVER_PORT=3001
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/linkedin/callback
LINKEDIN_STATE_SECRET=your_linkedin_state_secret
LINKEDIN_TOKEN_KEY=your_linkedin_token_key
FRONTEND_URL=http://localhost:3000
LOGTO_ISSUER=https://v0v3qk.logto.app/oidc
LOGTO_JWKS_URL=https://v0v3qk.logto.app/oidc/jwks
LOGTO_AUDIENCE=https://api.codigoavoluntad.com

# Mail (opcional). Sin SMTP_HOST, los envíos quedan SIMULADO.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=contraseña_de_aplicacion
SMTP_FROM="Código a Voluntad <tucuenta@gmail.com>"

# Tareas programadas (opcional: vacías usan los valores por defecto, ver DESPLIEGUE.md)
# CRON_CIERRE_AUTOMATICO=5 * * * *
# CRON_MATCHING=*/5 * * * *
# CRON_MATCHING_COMPLETO=0 4 * * 0
# MATCHING_UMBRAL_CAMBIOS=5
# MATCHING_ESPERA_MAXIMA_MIN=30
